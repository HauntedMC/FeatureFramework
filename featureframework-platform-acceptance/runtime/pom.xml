<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>nl.hauntedmc.featureframework</groupId>
        <artifactId>featureframework-platform-acceptance</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>featureframework-platform-acceptance-runtime</artifactId>
    <packaging>pom</packaging>
    <name>FeatureFramework Paper and Velocity Runtime Acceptance</name>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>boot-paper-and-velocity</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>${project.parent.basedir}/run-platform-acceptance.sh</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

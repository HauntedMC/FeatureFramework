<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>nl.hauntedmc.featureframework</groupId>
    <artifactId>featureframework-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>FeatureFramework</name>
    <description>Platform-neutral feature framework with Paper and Velocity adapters.</description>
    <url>https://github.com/HauntedMC/FeatureFramework</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>HauntedMC</name>
        <url>https://www.hauntedmc.nl</url>
    </organization>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>HauntedMC</id>
            <name>HauntedMC</name>
            <url>https://www.hauntedmc.nl</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/HauntedMC/FeatureFramework.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/HauntedMC/FeatureFramework.git</developerConnection>
        <url>https://github.com/HauntedMC/FeatureFramework</url>
        <tag>HEAD</tag>
    </scm>
    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/HauntedMC/FeatureFramework/issues</url>
    </issueManagement>
    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/HauntedMC/FeatureFramework/actions</url>
    </ciManagement>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages - FeatureFramework</name>
            <url>https://maven.pkg.github.com/HauntedMC/FeatureFramework</url>
        </repository>
    </distributionManagement>

    <modules>
        <module>featureframework-testkit</module>
        <module>featureframework-mockito-testkit</module>
        <module>featureframework-api</module>
        <module>featureframework-shared</module>
        <module>featureframework-paper</module>
        <module>featureframework-velocity</module>
    </modules>

    <properties>
        <revision>2.0.0</revision>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <project.build.outputTimestamp>2026-08-13T00:00:00Z</project.build.outputTimestamp>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>

        <paper.version>26.2.build.65-beta</paper.version>
        <velocity.version>4.1.0-SNAPSHOT</velocity.version>
        <paper.runtime.version>26.2</paper.runtime.version>
        <paper.runtime.build>65</paper.runtime.build>
        <paper.runtime.sha256>d290ee2a3ae92fea10afb0c74f797023d74cfd72cbcee44314e0c50d5551f2c6</paper.runtime.sha256>
        <velocity.runtime.build>9</velocity.runtime.build>
        <velocity.runtime.sha256>635ffe27b4fe1b97e61479012121d4e7c61a9eec99e6bd5a1f923053c2a259ce</velocity.runtime.sha256>
        <adventure.version>5.2.0</adventure.version>
        <configurate.version>4.2.0</configurate.version>
        <gson.version>2.14.0</gson.version>
        <slf4j.version>2.0.18</slf4j.version>
        <errorprone.annotations.version>2.49.0</errorprone.annotations.version>
        <brigadier.version>1.3.10</brigadier.version>
        <packetevents.version>2.13.0</packetevents.version>
        <placeholderapi.version>2.12.3</placeholderapi.version>
        <viaversion.version>5.11.0</viaversion.version>
        <dataregistry.version>1.13.4</dataregistry.version>
        <dataprovider.version>3.1.10</dataprovider.version>
        <jakarta.persistence.version>3.2.0</jakarta.persistence.version>
        <hibernate.version>7.4.5.Final</hibernate.version>

        <junit.version>6.1.2</junit.version>
        <mockito.version>5.23.0</mockito.version>
        <bytebuddy.version>1.17.7</bytebuddy.version>
        <maven.enforcer.version>3.6.3</maven.enforcer.version>
        <flatten.plugin.version>1.7.3</flatten.plugin.version>
        <maven.checkstyle.plugin.version>3.6.0</maven.checkstyle.plugin.version>
        <checkstyle.version>13.8.0</checkstyle.version>
        <maven.compiler.plugin.version>3.15.0</maven.compiler.plugin.version>
        <maven.surefire.version>3.5.6</maven.surefire.version>
        <maven.jar.version>3.5.1</maven.jar.version>
        <maven.source.version>3.3.1</maven.source.version>
        <maven.javadoc.version>3.11.2</maven.javadoc.version>
        <maven.shade.version>3.6.2</maven.shade.version>
        <exec.maven.plugin.version>3.6.2</exec.maven.plugin.version>
        <maven.deploy.version>3.1.4</maven.deploy.version>
        <jacoco.version>0.8.15</jacoco.version>
    </properties>

    <repositories>
        <repository><id>central</id><url>https://repo.maven.apache.org/maven2</url></repository>
        <repository><id>papermc</id><url>https://repo.papermc.io/repository/maven-public/</url></repository>
        <repository><id>codemc-releases</id><url>https://repo.codemc.io/repository/maven-releases/</url></repository>
        <repository><id>codemc-snapshots</id><url>https://repo.codemc.io/repository/maven-snapshots/</url></repository>
        <repository><id>placeholderapi</id><url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url></repository>
        <repository><id>viaversion-repo</id><url>https://repo.viaversion.com</url></repository>
        <repository><id>github</id><url>https://maven.pkg.github.com/HauntedMC/*</url></repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>net.kyori</groupId>
                <artifactId>adventure-bom</artifactId>
                <version>${adventure.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_annotations</artifactId>
                <version>${errorprone.annotations.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                        <showWarnings>true</showWarnings>
                        <showDeprecation>true</showDeprecation>
                        <failOnWarning>true</failOnWarning>
                        <compilerArgs>
                            <arg>-Xlint:all,-processing</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.version}</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                        <argLine>@{argLine} -javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${bytebuddy.version}/byte-buddy-agent-${bytebuddy.version}.jar -Dnet.bytebuddy.experimental=true</argLine>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>net.bytebuddy</groupId>
                            <artifactId>byte-buddy-agent</artifactId>
                            <version>${bytebuddy.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven.jar.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven.source.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven.javadoc.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven.shade.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec.maven.plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven.deploy.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten.plugin.version}</version>
                <configuration><flattenMode>resolveCiFriendliesOnly</flattenMode></configuration>
                <executions>
                    <execution><id>flatten</id><phase>process-resources</phase><goals><goal>flatten</goal></goals></execution>
                    <execution><id>flatten-clean</id><phase>clean</phase><goals><goal>clean</goal></goals></execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer.version}</version>
                <executions>
                    <execution>
                        <id>enforce-build</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion><version>[25,26.1)</version></requireJavaVersion>
                                <requireMavenVersion><version>[3.8.6,)</version></requireMavenVersion>
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution><goals><goal>prepare-agent</goal></goals></execution>
                    <execution><id>report</id><phase>verify</phase><goals><goal>report</goal></goals></execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven.checkstyle.plugin.version}</version>
                <configuration>
                    <configLocation>${maven.multiModuleProjectDirectory}/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>warning</violationSeverity>
                    <consoleOutput>true</consoleOutput>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>release-style-gate</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>platform-acceptance</id>
            <modules>
                <module>featureframework-platform-acceptance</module>
            </modules>
        </profile>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions><execution><id>sources</id><goals><goal>jar-no-fork</goal></goals></execution></executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions><execution><id>javadoc</id><goals><goal>jar</goal></goals></execution></executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
